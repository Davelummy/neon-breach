{
  "name": "neon-breach",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:firebase": "node scripts/firebase/test-emulator.mjs",
    "qa": "node scripts/qa-smoke.mjs",
    "qa:responsive": "node scripts/qa-responsive.mjs",
    "qa:multiplayer": "node scripts/qa-multiplayer.mjs",
    "qa:multiplayer:release": "node scripts/qa-multiplayer.mjs --full-round",
    "qa:guest": "node scripts/qa-guest.mjs",
    "qa:visual": "node scripts/qa-visual.mjs",
    "qa:arena-preview": "node scripts/qa-arena-preview.mjs",
    "verify": "npm test && npm run qa",
    "blender:check": "node scripts/blender/run-healthcheck.mjs",
    "mcp:check": "node scripts/check-mcp-prereqs.mjs",
    "start": "SERVE_DIST=1 node scripts/serve.mjs --dist",
    "start:multiplayer": "node scripts/serve-match.mjs",
    "db:generate": "drizzle-kit generate",
    "netlify:build": "npm run build",
    "netlify:deploy": "npm run build && npx --yes netlify-cli deploy --prod",
    "qa:hud": "node scripts/qa-hud-layout.mjs"
  },
  "dependencies": {
    "@netlify/blobs": "^10.7.9",
    "drizzle-orm": "0.45.2",
    "three": "^0.180.0",
    "ws": "8.21.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "drizzle-kit": "0.31.10",
    "esbuild": "^0.28.1",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.5.0",
    "puppeteer-core": "^25.3.0"
  }
}
